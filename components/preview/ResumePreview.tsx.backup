'use client';

import { useResumeStore } from '@/stores';
import { ContactData, SummaryData, ExperienceData, EducationData, SkillsData, CustomData } from '@/types';
import { formatDateRange } from '@/lib/dateUtils';
import { Mail, Phone, MapPin, Linkedin, Github, Globe, Heart, Book, Clock, Quote } from 'lucide-react';
import { ContactQRCode } from '@/components/features/QRCodeGenerator';
import { getTemplate } from '@/lib/templates';
import ReactMarkdown from 'react-markdown';

export function ResumePreview() {
  const currentResume = useResumeStore((state) => state.currentResume);

  if (!currentResume) {
    return <div>No resume to preview</div>;
  }

  const { sections, settings, templateId } = currentResume;
  const template = getTemplate(templateId || 'modern');
  const visibleSections = sections
    .filter((s) => s.visible)
    .sort((a, b) => a.order - b.order);

  // Apply template-specific spacing
  const spacingMap = {
    compact: '12px',
    normal: '20px',
    relaxed: '32px',
  };
  const sectionSpacing = spacingMap[template.style.spacing];

  return (
    <div
      className="a4-page mx-auto print-exact"
      style={{
        backgroundColor: settings.theme.backgroundColor,
        color: settings.theme.textColor,
        fontFamily: settings.theme.fontPair.body,
      }}
    >
      <div
        style={{
          padding: `${settings.layout.margins.top}mm ${settings.layout.margins.right}mm ${settings.layout.margins.bottom}mm ${settings.layout.margins.left}mm`,
        }}
      >
        {visibleSections.map((section) => (
          <div
            key={section.id}
            style={{ marginBottom: sectionSpacing }}
            className={template.style.sectionStyle === 'card' ? 'p-4 bg-gray-50 rounded-lg' : ''}
          >
            {section.type === 'contact' && <ContactPreview data={section.data as ContactData} theme={settings.theme} />}
            {section.type === 'summary' && <SummaryPreview data={section.data as SummaryData} theme={settings.theme} />}
            {section.type === 'experience' && <ExperiencePreview data={section.data as ExperienceData} theme={settings.theme} />}
            {section.type === 'education' && <EducationPreview data={section.data as EducationData} theme={settings.theme} />}
            {section.type === 'skills' && <SkillsPreview data={section.data as SkillsData} theme={settings.theme} />}
            {section.type === 'custom' && <CustomSectionPreview data={section.data as CustomData} title={section.title} theme={settings.theme} />}
          </div>
        ))}
      </div>
    </div>
  );
}

function ContactPreview({ data, theme }: { data: ContactData; theme: any }) {
  const iconMap: Record<string, any> = {
    linkedin: Linkedin,
    github: Github,
    website: Globe,
    portfolio: Globe,
    custom: Globe,
  };

  return (
    <div className="text-center border-b pb-6" style={{ borderColor: theme.primaryColor + '30' }}>
      <h1
        className="text-4xl font-bold mb-2"
        style={{
          color: theme.primaryColor,
          fontFamily: theme.fontPair.heading,
        }}
      >
        {data.fullName || 'Your Name'}
      </h1>
      <p className="text-xl mb-4" style={{ color: theme.secondaryColor }}>
        {data.title || 'Your Professional Title'}
      </p>

      <div className="flex items-center justify-center gap-6 text-sm flex-wrap">
        {data.email && (
          <div className="flex items-center gap-2">
            <Mail className="w-4 h-4" />
            <span>{data.email}</span>
          </div>
        )}
        {data.phone && (
          <div className="flex items-center gap-2">
            <Phone className="w-4 h-4" />
            <span>{data.phone}</span>
          </div>
        )}
        {data.location && (
          <div className="flex items-center gap-2">
            <MapPin className="w-4 h-4" />
            <span>{data.location}</span>
          </div>
        )}
      </div>

      {data.links && data.links.length > 0 && (
        <div className="mt-4">
          <div className="flex items-center justify-center gap-4 flex-wrap">
            {data.links.map((link) => {
              const Icon = iconMap[link.type];
              return (
                <a
                  key={link.id}
                  href={link.url}
                  className="flex items-center gap-1 text-sm hover:underline"
                  style={{ color: theme.primaryColor }}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {Icon && <Icon className="w-4 h-4" />}
                  <span>{link.label}</span>
                </a>
              );
            })}
          </div>
          
          {/* QR Codes Row */}
          {data.links.some((link) => link.showQR) && (
            <div className="flex items-center justify-center gap-4 mt-3 print:mt-2">
              {data.links
                .filter((link) => link.showQR)
                .map((link) => (
                  <ContactQRCode key={link.id} label={link.label} url={link.url} />
                ))}
            </div>
          )}
        </div>
      )}
    </div>
  );
}

function SummaryPreview({ data, theme }: { data: SummaryData; theme: any }) {
  if (!data.content) return null;

  return (
    <div>
      <h2
        className="text-2xl font-bold mb-3 pb-2 border-b"
        style={{
          color: theme.primaryColor,
          borderColor: theme.primaryColor,
          fontFamily: theme.fontPair.heading,
        }}
      >
        Professional Summary
      </h2>
      <div className="text-sm leading-relaxed prose prose-sm max-w-none">
        <ReactMarkdown>{data.content}</ReactMarkdown>
      </div>
    </div>
  );
}

function ExperiencePreview({ data, theme }: { data: ExperienceData; theme: any }) {
  if (!data.items || data.items.length === 0) return null;

  return (
    <div>
      <h2
        className="text-2xl font-bold mb-4 pb-2 border-b"
        style={{
          color: theme.primaryColor,
          borderColor: theme.primaryColor,
          fontFamily: theme.fontPair.heading,
        }}
      >
        Work Experience
      </h2>

      <div className="space-y-4">
        {data.items.map((item) => (
          <div key={item.id}>
            <div className="flex justify-between items-start mb-2">
              <div className="flex-1">
                <h3 className="text-lg font-bold" style={{ color: theme.secondaryColor }}>
                  {item.position}
                </h3>
                <p className="text-sm font-semibold">{item.company}</p>
              </div>
              <div className="text-right text-sm">
                <p className="font-medium">{item.location}</p>
                <p className="text-gray-600">
                  {item.startDate && formatDateRange(item.startDate, item.endDate)}
                </p>
              </div>
            </div>

            {item.highlights && item.highlights.length > 0 && item.highlights[0] && (
              <ul className="list-disc list-inside space-y-1 text-sm">
                {item.highlights
                  .filter((h) => h.trim())
                  .map((highlight, idx) => (
                    <li key={idx} className="prose prose-sm max-w-none inline">
                      <ReactMarkdown components={{ p: 'span' }}>{highlight}</ReactMarkdown>
                    </li>
                  ))}
              </ul>
            )}

            {item.skills && item.skills.length > 0 && (
              <div className="flex flex-wrap gap-2 mt-2">
                {item.skills.map((skill, idx) => (
                  <span
                    key={idx}
                    className="px-2 py-1 text-xs rounded"
                    style={{
                      backgroundColor: theme.primaryColor + '20',
                      color: theme.primaryColor,
                    }}
                  >
                    {skill}
                  </span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  );
}

function EducationPreview({ data, theme }: { data: EducationData; theme: any }) {
  if (!data.items || data.items.length === 0) return null;

  return (
    <div>
      <h2
        className="text-2xl font-bold mb-4 pb-2 border-b"
        style={{
          color: theme.primaryColor,
          borderColor: theme.primaryColor,
          fontFamily: theme.fontPair.heading,
        }}
      >
        Education
      </h2>

      <div className="space-y-3">
        {data.items.map((item) => (
          <div key={item.id}>
            <div className="flex justify-between items-start">
              <div className="flex-1">
                <h3 className="text-lg font-bold" style={{ color: theme.secondaryColor }}>
                  {item.degree} in {item.field}
                </h3>
                <p className="text-sm font-semibold">{item.institution}</p>
                {item.gpa && <p className="text-sm">GPA: {item.gpa}</p>}
                {item.honors && <p className="text-sm italic">{item.honors}</p>}
              </div>
              <div className="text-right text-sm">
                <p className="font-medium">{item.location}</p>
                <p className="text-gray-600">
                  {item.startDate && formatDateRange(item.startDate, item.endDate)}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}

function SkillsPreview({ data, theme }: { data: SkillsData; theme: any }) {
  if (!data.categories || data.categories.length === 0) return null;

  return (
    <div>
      <h2
        className="text-2xl font-bold mb-4 pb-2 border-b"
        style={{
          color: theme.primaryColor,
          borderColor: theme.primaryColor,
          fontFamily: theme.fontPair.heading,
        }}
      >
        Skills
      </h2>

      <div className="space-y-3">
        {data.categories.map((category) => (
          <div key={category.id}>
            <h3 className="text-sm font-bold mb-2" style={{ color: theme.secondaryColor }}>
              {category.name}
            </h3>
            <div className="flex flex-wrap gap-2">
              {category.skills.map((skill) => (
                <span
                  key={skill.id}
                  className="px-3 py-1 text-sm rounded-full"
                  style={{
                    backgroundColor: theme.primaryColor + '15',
                    color: theme.textColor,
                    border: `1px solid ${theme.primaryColor}40`,
                  }}
                >
                  {skill.name}
                  {skill.level && (
                    <span className="ml-1 text-xs opacity-75">
                      • {skill.level}
                    </span>
                  )}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}

function CustomSectionPreview({ data, title, theme }: { data: CustomData; title: string; theme: any }) {
  const iconMap = {
    hobbies: Heart,
    books: Book,
    timeline: Clock,
    philosophy: Quote,
    freeform: null,
  };

  const Icon = iconMap[data.type];

  // Timeline/Pie Chart view
  if (data.type === 'timeline' && data.items.length > 0) {
    const total = data.items.reduce((sum, item) => sum + (item.value || 0), 0);
    let currentAngle = 0;

    return (
      <div>
        <h2 className="text-xl font-bold mb-4" style={{ color: theme.primaryColor }}>
          {title}
        </h2>
        <div className="flex items-center gap-6">
          <svg width="120" height="120" viewBox="0 0 120 120" className="flex-shrink-0">
            {data.items.map((item) => {
              const percentage = (item.value || 0) / total;
              const angle = percentage * 360;
              const largeArc = angle > 180 ? 1 : 0;
              
              const startAngle = (currentAngle - 90) * (Math.PI / 180);
              const endAngle = (currentAngle + angle - 90) * (Math.PI / 180);
              
              const x1 = 60 + 50 * Math.cos(startAngle);
              const y1 = 60 + 50 * Math.sin(startAngle);
              const x2 = 60 + 50 * Math.cos(endAngle);
              const y2 = 60 + 50 * Math.sin(endAngle);
              
              const path = `M 60 60 L ${x1} ${y1} A 50 50 0 ${largeArc} 1 ${x2} ${y2} Z`;
              currentAngle += angle;
              
              return (
                <path
                  key={item.id}
                  d={path}
                  fill={item.color || theme.primaryColor}
                  opacity="0.8"
                />
              );
            })}
          </svg>
          <div className="flex-1 space-y-2">
            {data.items.map((item) => (
              <div key={item.id} className="flex items-center gap-2 text-sm">
                <div
                  className="w-3 h-3 rounded-full"
                  style={{ backgroundColor: item.color || theme.primaryColor }}
                />
                <span>{item.text}</span>
                <span className="text-gray-500">({item.value}%)</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    );
  }

  // List view for other types
  return (
    <div>
      <h2 className="text-xl font-bold mb-4" style={{ color: theme.primaryColor }}>
        {title}
      </h2>
      
      {data.type === 'philosophy' ? (
        <div className="space-y-3">
          {data.items.map((item) => (
            <div key={item.id} className="pl-4 border-l-2" style={{ borderColor: theme.primaryColor }}>
              <p className="italic text-gray-700">"{item.text}"</p>
            </div>
          ))}
        </div>
      ) : (
        <div className="flex flex-wrap gap-3">
          {data.items.map((item) => (
            <div
              key={item.id}
              className="flex items-center gap-2 px-3 py-1.5 rounded-full"
              style={{
                backgroundColor: theme.primaryColor + '15',
                border: `1px solid ${theme.primaryColor}40`,
              }}
            >
              {Icon && <Icon className="w-4 h-4" style={{ color: theme.primaryColor }} />}
              <span className="text-sm">{item.text}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}
